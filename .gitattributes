# The release tarball is a `git archive` of the whole repo now that the package
# is the repo root, so keep the CI and dev-only files out of it (git archive
# honours export-ignore; a git checkout does not).
.github/ export-ignore
scripts/ export-ignore
.githooks/ export-ignore
.oxlintrc.json export-ignore
.oxfmtrc.json export-ignore
pnpm-lock.yaml export-ignore
