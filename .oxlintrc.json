{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Setting `plugins` REPLACES oxlint's default set (eslint, unicorn, oxc,
  // typescript), so every wanted plugin is listed: the four defaults plus the
  // opt-ins that apply to a plain ESM package — ESM resolution, promise misuse,
  // node APIs, JSDoc. No extra plugin dependencies: these are all built in.
  "plugins": ["eslint", "unicorn", "typescript", "oxc", "import", "promise", "node", "jsdoc"],
  // `correctness` (the default) is an error; the next two are measured to be
  // worth it. `style` and `pedantic` stay off: they report 412 and 57 findings
  // on this codebase, nearly all layout opinions.
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  // lib/client.js is a bundled artifact: 905 of its 1278 lines are token tables
  // generated by scripts/build-tables.mjs and byte-compared by `--check` and
  // test/themes.mjs, and the rest is a `window.__ModuleLoader__` wrapper that is
  // not hand-shaped layout. Its findings were structural (function scoping in a
  // bundle factory) or false positives (`__ModuleLoader__` is the harness global).
  "ignorePatterns": ["lib/client.js"]
}
